{
  "uid": "car-park-app",
  "title": "car_park — приложение",
  "description": "Метрики Micrometer из /actuator/prometheus. На панели латентности включены exemplars: клик по маркеру открывает трейс в Tempo.",
  "tags": ["car_park"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance_id",
        "label": "Инстанс",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(jvm_memory_used_bytes{application=\"car_park\"}, instance_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPS по эндпоинтам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Доля ответов 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 20, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])), 0.0001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RPS по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Латентность эндпоинтов (p95 по эндпоинтам, p99 общий)",
      "description": "Ромбовидные маркеры — exemplars. Клик по маркеру открывает конкретный трейс в Tempo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])))",
          "legendFormat": "p95 {{uri}}",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])))",
          "legendFormat": "p99 общий",
          "exemplar": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Память JVM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"car_park\", instance_id=~\"$instance_id\"})",
          "legendFormat": "used {{area}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (area) (jvm_memory_committed_bytes{application=\"car_park\", instance_id=~\"$instance_id\"})",
          "legendFormat": "committed {{area}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Паузы GC",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum{application=\"car_park\", instance_id=~\"$instance_id\"}[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Потоки JVM",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "живые"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_daemon_threads{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "демоны"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_cpu_usage{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "процесс"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "system_cpu_usage{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "система"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Пул соединений, Tomcat, Kafka",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "HikariCP",
      "description": "pending > 0 означает, что потоки ждут соединение — пул исчерпан",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "активные"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_idle{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "простаивающие"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_pending{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "ожидают соединения"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Потоки Tomcat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tomcat_threads_busy_threads{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "занятые"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tomcat_threads_current_threads{application=\"car_park\", instance_id=~\"$instance_id\"}",
          "legendFormat": "всего"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Kafka producer",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(kafka_producer_record_send_total{application=\"car_park\", instance_id=~\"$instance_id\"}[1m])",
          "legendFormat": "отправлено/с"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(kafka_producer_record_error_total{application=\"car_park\", instance_id=~\"$instance_id\"}[1m])",
          "legendFormat": "ошибок/с"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Бизнес-метрики",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Размер автопарка",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(car_park_vehicles{application=\"car_park\"})",
          "legendFormat": "ТС"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(car_park_enterprises{application=\"car_park\"})",
          "legendFormat": "Предприятия"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(car_park_trips{application=\"car_park\"})",
          "legendFormat": "Поездки"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Обращения к Geoapify (cache missing)",
      "description": "Метод под @Cacheable, поэтому таймер считает только реальные внешние вызовы",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (exception) (rate(geoapify_address_lookup_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[1m]))",
          "legendFormat": "вызовов/с (exception={{exception}})"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Латентность Geoapify",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(geoapify_address_lookup_seconds_bucket{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])))",
          "legendFormat": "Geoapify p95",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (operation) (rate(car_park_import_seconds_sum{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])) / clamp_min(sum by (operation) (rate(car_park_import_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])), 0.0001)",
          "legendFormat": "импорт, среднее"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (operation) (rate(car_park_export_seconds_sum{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])) / clamp_min(sum by (operation) (rate(car_park_export_seconds_count{application=\"car_park\", instance_id=~\"$instance_id\"}[5m])), 0.0001)",
          "legendFormat": "экспорт, среднее"
        }
      ]
    }
  ]
}
